<Configuration status="OFF">
    <Appenders>
        <Console name="MyConsoleLog" target="SYSTEM_OUT">
            <PatternLayout pattern="-------%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg---------%n"/>
        </Console>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="OFF" additivity="false">
            <AppenderRef ref="Console"/>
        </Root>
        <Logger name="org.example" level="debug" additivity="false">
            <AppenderRef ref="MyConsoleLog"/>
        </Logger>


        <Logger name="com.zaxxer.hikari" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger> <!-- Основные события -->
        <Logger name="com.zaxxer.hikari.pool" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger> <!-- Детали работы пула -->
        <Logger name="org.springframework.orm.hibernate5.HibernateTransactionManager" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

    </Loggers>
</Configuration>